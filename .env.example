# Where Seerr answers, as seen from this app (a container name works when both share a network).
LOMBO_GATE_SEERR_URL=http://seerr:5055
# Seerr: Settings > General > API Key.
LOMBO_GATE_SEERR_API_KEY=changeme
# Sonarr, used only to read how big a minute of video is for your quality.
LOMBO_GATE_SONARR_URL=http://sonarr:8989
# Sonarr: Settings > General > API Key.
LOMBO_GATE_SONARR_API_KEY=changeme
# A TV request for more seasons than this waits for you.
LOMBO_GATE_MAX_SEASONS=5
# A TV request with a bigger estimated size than this (GB) waits for you.
LOMBO_GATE_MAX_GB=125
# The Sonarr quality whose preferred size the estimate uses (Settings > Quality).
LOMBO_GATE_QUALITY=WEBDL-1080p
# Optional. Any webhook that accepts JSON (Discord, Slack, or a bridge). Empty means no alerts.
LOMBO_GATE_WEBHOOK_URL=
# true = show what would happen and approve nothing. Set false only after reading the output of `plan`.
LOMBO_GATE_DRY_RUN=true
# Seconds between rounds when running with --loop. At least 10.
LOMBO_GATE_INTERVAL_SECONDS=60
# Remembers which waiting requests you have been told about. Keep it on a volume.
LOMBO_GATE_STATE_FILE=/data/state.json
